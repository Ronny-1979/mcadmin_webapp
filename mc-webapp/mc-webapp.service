[Unit]
Description=Minecraft WebApp Panel
After=network.target minecraft-bedrock.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/mc-webapp/backend
ExecStart=/usr/bin/node /opt/mc-webapp/backend/server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
