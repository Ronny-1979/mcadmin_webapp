[Unit]
Description=MC Admin WebApp (React + Node.js)
Documentation=https://github.com/Ronny-1979/mcadmin_webapp
After=network.target apache2.service minecraft-bedrock.service
Wants=minecraft-bedrock.service

[Service]
Type=simple
User=www-data
Group=www-data
# WorkingDirectory und ExecStart werden von install.sh automatisch gesetzt
WorkingDirectory=/opt/mc-webapp/backend
ExecStart=/usr/bin/node /opt/mc-webapp/backend/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mc-webapp
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
